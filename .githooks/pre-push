#!/bin/sh
# 푸시할 새 커밋의 작성자·커밋터 이메일이 모두 GitHub noreply 주소인지 확인한다.
zero="0000000000000000000000000000000000000000"
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  bad="$(git log --format='%h %ae %ce' "$local_sha" --not --remotes 2>/dev/null | grep -v -E '^[^ ]+ ([^ ]+@users\.noreply\.github\.com|noreply@github\.com) ([^ ]+@users\.noreply\.github\.com|noreply@github\.com)$' | head -3)"
  if [ -n "$bad" ]; then
    echo "noreply 가 아닌 이메일이 들어 있어 푸시를 막는다 (docs/GIT.md):" >&2
    echo "$bad" >&2
    exit 1
  fi
done
exit 0
