#!/bin/sh
# 커밋 메시지에서 AI 생성 표식과 Claude co-author 트레일러를 제거한다.
#
# 이 훅은 권고가 아니라 하드 게이트다. `git commit -m`, 에디터 커밋, amend,
# cherry-pick, revert 등 커밋 메시지가 만들어지는 모든 경로에서 실행된다.
# (`--no-verify` 로만 우회 가능.)
#
# 활성화: `git config core.hooksPath .githooks` — `npm install` 의 prepare
# 스크립트가 자동으로 설정한다. 수동으로도 한 번 실행하면 된다.
#
# 줄 전체가 트레일러일 때만 지운다. 본문에서 이 문자열을 예시로 언급하는
# 줄("...`Co-Authored-By: Claude` 를 넣지 않는다")은 건드리지 않는다.

msg_file="$1"
[ -f "$msg_file" ] || exit 0

tmp="$(mktemp)" || exit 0

# 제거 대상 (줄 앞 공백 허용, 대소문자 무관):
#  - "Co-authored-by: Claude ..."                     전체 줄
#  - "🤖 Generated with [Claude Code](...)"           전체 줄 (이모지/대괄호 유무 무관)
#  - "Generated by Claude Code"                        전체 줄
grep -vaiE \
  -e '^[[:space:]]*co-authored-by:[[:space:]]*claude([[:space:]]|<|$)' \
  -e '^[[:space:]]*(🤖[[:space:]]*)?generated (with|by) \[?claude( code)?\]?' \
  "$msg_file" > "$tmp" || true

# 위 삭제로 생긴 파일 끝의 연속 빈 줄을 정리한다(본문 중간 빈 줄은 보존).
awk '
  { lines[NR] = $0 }
  END {
    last = NR
    while (last > 0 && lines[last] ~ /^[[:space:]]*$/) last--
    for (i = 1; i <= last; i++) print lines[i]
  }
' "$tmp" > "$msg_file"

rm -f "$tmp"
exit 0
