{
  "name": "chatgpt-conversation-maintenance",
  "version": "1.0.0",
  "private": true,
  "description": "Private, review-gated maintenance for ChatGPT conversations and projects",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "start": "node src/launcher.js",
    "app": "node src/launcher.js",
    "dev:fake": "node dev/fake-server.js",
    "brief": "node src/brief.js",
    "lock": "node src/maintenance-lock.js",
    "test": "node --test",
    "repo:check": "node src/repo-check.js",
    "stop": "node src/launcher.js stop",
    "status": "node src/launcher.js status"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT"
}
